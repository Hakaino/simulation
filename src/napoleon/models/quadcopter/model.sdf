<?xml version="1.0"?>
<sdf version="1.9">
  <model name="quadcopter">
    <static>false</static>
    <pose>0 0 0.18 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.021</ixx>
          <iyy>0.021</iyy>
          <izz>0.038</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.18 0.18 0.06</size>
          </box>
        </geometry>
      </collision>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.18 0.18 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.18 0.18 0.22 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="arm_front_left">
        <pose>0.09 0.09 0 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.26 0.03 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.15 0.15 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <visual name="arm_front_right">
        <pose>0.09 -0.09 0 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.26 0.03 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.7 1</ambient>
          <diffuse>0.2 0.2 0.85 1</diffuse>
        </material>
      </visual>

      <visual name="camera_mount_visual">
        <pose>0.085 0 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.04 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <visual name="camera_body_visual">
        <pose>0.12 0 -0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.03 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <visual name="down_camera_mount_visual">
        <pose>0 0 -0.026 0 0 0</pose>
        <geometry>
          <box>
            <size>0.045 0.045 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.09 0.09 0.09 1</diffuse>
        </material>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <visualize>false</visualize>
        <imu>
          <enable_orientation>false</enable_orientation>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.003</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.003</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.003</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="barometer" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <air_pressure>
          <reference_altitude>0.0</reference_altitude>
          <pressure>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.5</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="front_camera" type="camera">
        <pose>0.12 0 -0.015 0 0.15 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera name="front_camera">
          <horizontal_fov>1.3962634</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>381.36112213134766</fx>
              <fy>381.361141204834</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.08</near>
            <far>50.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.006</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name="down_camera" type="camera">
        <pose>0 0 -0.09 0 1.57079632679 0</pose>
        <always_on>true</always_on>
        <update_rate>45</update_rate>
        <visualize>false</visualize>
        <camera name="down_camera">
          <horizontal_fov>1.22173048</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>415.69219381653056</fx>
              <fy>415.69219381653056</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>25.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.004</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <link name="rotor_front_left">
      <pose>0.18 0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00004</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.25 0.25 1</ambient>
          <diffuse>0.95 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_front_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_front_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <link name="rotor_front_right">
      <pose>0.18 -0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00004</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.85 1</ambient>
          <diffuse>0.25 0.25 0.95 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_front_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_front_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <link name="rotor_rear_right">
      <pose>-0.18 -0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00004</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.85 1</ambient>
          <diffuse>0.25 0.25 0.95 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_rear_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_rear_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <link name="rotor_rear_left">
      <pose>-0.18 0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00004</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.25 0.25 1</ambient>
          <diffuse>0.95 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_rear_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_rear_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <plugin filename="gz-sim8-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>quadcopter</robotNamespace>
      <jointName>rotor_front_left_joint</jointName>
      <linkName>rotor_front_left</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>900.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10.0</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim8-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>quadcopter</robotNamespace>
      <jointName>rotor_front_right_joint</jointName>
      <linkName>rotor_front_right</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>900.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10.0</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim8-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>quadcopter</robotNamespace>
      <jointName>rotor_rear_right_joint</jointName>
      <linkName>rotor_rear_right</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>900.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>2</actuator_number>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10.0</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim8-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>quadcopter</robotNamespace>
      <jointName>rotor_rear_left_joint</jointName>
      <linkName>rotor_rear_left</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>900.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>3</actuator_number>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10.0</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
