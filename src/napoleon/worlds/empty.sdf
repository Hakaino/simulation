<?xml version="1.0"?>
<sdf version="1.9">
  <world name="empty_world">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim8-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim8-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim8-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim8-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim8-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim8-air-pressure-system" name="gz::sim::systems::AirPressure"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.9 0.9 0.95 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.78 0.8 0.78 1</ambient>
            <diffuse>0.82 0.84 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="landing_pad">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3 3 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3 3 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.2 0.12 1</ambient>
            <diffuse>0.15 0.3 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="center_cross_long">
          <pose>0 0 0.011 0 0 0</pose>
          <geometry>
            <box>
              <size>2.2 0.2 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.96 0.96 0.96 1</ambient>
            <diffuse>0.99 0.99 0.99 1</diffuse>
          </material>
        </visual>
        <visual name="center_cross_wide">
          <pose>0 0 0.011 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 2.2 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.96 0.96 0.96 1</ambient>
            <diffuse>0.99 0.99 0.99 1</diffuse>
          </material>
        </visual>
        <visual name="center_marker">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.35 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.06 0.06 0.06 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="north_marker">
          <pose>0 1.1 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.24 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.55 0.12 1</ambient>
            <diffuse>0.98 0.62 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="southwest_marker">
          <pose>-0.95 -0.95 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.35 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.06 0.06 0.06 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="southeast_marker">
          <pose>0.95 -0.95 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.35 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.96 0.96 0.96 1</ambient>
            <diffuse>0.99 0.99 0.99 1</diffuse>
          </material>
        </visual>
        <visual name="northwest_marker">
          <pose>-0.95 0.95 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.35 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.96 0.96 0.96 1</ambient>
            <diffuse>0.99 0.99 0.99 1</diffuse>
          </material>
        </visual>
        <visual name="northeast_marker">
          <pose>0.95 0.95 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.35 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.06 0.06 0.06 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 0.01 0 0 0</pose>
    </model>

    <include>
      <uri>model://quadcopter</uri>
      <name>quadcopter</name>
      <pose>0 0 0.18 0 0 0</pose>
    </include>
  </world>
</sdf>
