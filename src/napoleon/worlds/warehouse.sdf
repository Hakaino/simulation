      <pose>8.0 5.5 0.8 0 0 0</pose>
    </model>

    <include>
      <uri>model://quadcopter</uri>
      <name>quadcopter</name>
      <pose>0 0 0.18 0 0 0</pose>
    </include>
  </world>
</sdf>
